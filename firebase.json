{
  "functions": {
    "source": "server",
    "codebase": "default",
    "ignore": [
      "node_modules",
      ".env",
      "*.db",
      "*.db-shm",
      "*.db-wal",
      "*.log"
    ]
  },
  "firestore": {
    "database": "(default)",
    "location": "nam5",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "client/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
