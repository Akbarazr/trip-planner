# Copy this file to ".env" and fill in your key.

# Recommended free option: Groq Console https://console.groq.com/keys
# Create your own key, then paste it here. Never commit the real key.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Alternative free option: Google AI Studio https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Use a model currently available to your Google AI Studio account.
GEMINI_MODEL=gemini-2.5-flash

# Live airline schedule and fare search. Amadeus aggregates offers from
# participating airlines. Create credentials for the Amadeus environment you use.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com

# Transitous supplies live/open train and bus schedules. Its usage policy asks
# clients to identify a contact URL or email in the User-Agent.
TRANSITOUS_BASE_URL=https://api.transitous.org
TRANSITOUS_CONTACT=http://localhost:5173

# Port for the API server
PORT=4000

# Production API hosting outside Google Cloud (for example, Vercel).
USE_FIRESTORE=false
CORS_ORIGINS=http://localhost:5173

# On Vercel, paste the complete Firebase service-account JSON as one encrypted
# environment variable. Do not commit the service-account file or JSON.
FIREBASE_SERVICE_ACCOUNT_JSON=
